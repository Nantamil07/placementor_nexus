generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ALUMNI
  MENTOR
  RECRUITER
  PLACEMENT_OFFICER
  ADMIN
}

model Profile {
  id          String      @id @default(cuid())
  clerkId     String      @unique
  email       String      @unique
  username    String      @unique
  fullName    String
  avatarUrl   String?
  bio         String?
  headline    String?
  role        UserRole    @default(STUDENT)
  isOnboarded Boolean     @default(false)
  skills      Skill[]
  education   Education[]
  projects    Project[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // --- Module 16: Admin ---
  isSuspended         Boolean @default(false)
  isVerifiedRecruiter Boolean @default(false)

  companiesFollowed   CompanyFollower[]
  jobsPosted          Job[]               @relation("JobPostedBy")
  jobApplications     JobApplication[]
  communityMembers    CommunityMember[]
  posts               Post[]
  comments            Comment[]
  eventsOrganized     Event[]             @relation("EventOrganizer")
  reportsFiled        Report[]            @relation("ReportsFiled")
  reportsResolved     Report[]            @relation("ReportsResolved")
  suspensionsIssued   UserSuspension[]    @relation("SuspensionsIssued")
  suspensionsRecieved UserSuspension[]    @relation("SuspensionsReceived")
  auditLogs           AuditLog[]
  notificationsSent   AdminNotification[]
  PostVotes           PostVote[]
  PostBookmarks       PostBookmark[]

  // Networking
  connectionsSent     Connection[] @relation("ConnectionsSent")
  connectionsReceived Connection[] @relation("ConnectionsReceived")
  followers           Follow[]     @relation("UserFollowers")
  following           Follow[]     @relation("UserFollowing")

  // Messaging
  conversations ConversationParticipant[]
  messagesSent  Message[]                 @relation("MessagesSent")

  // Referrals & Mentorship
  referralsRequested  Referral[]          @relation("ReferralsRequested")
  referralsReceived   Referral[]          @relation("ReferralsReceived")
  mentorshipsAsMentor MentorshipSession[] @relation("MentorshipAsMentor")
  mentorshipsAsMentee MentorshipSession[] @relation("MentorshipAsMentee")

  // Events & Notifications
  eventRegistrations     EventRegistration[]
  notifications          Notification[]      @relation("UserNotifications")
  notificationsTriggered Notification[]      @relation("TriggeredNotifications")

  @@index([role])
  @@index([username])
  @@index([isSuspended])
}

model Skill {
  id       String    @id @default(cuid())
  name     String    @unique
  profiles Profile[]
}

model Education {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  grade        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([profileId])
}

model Project {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String
  repoUrl     String?
  liveUrl     String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
}

// =========================================
// Module 16 — Admin Panel domain models
// =========================================

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  SELECTED
  WITHDRAWN
}

enum EventType {
  WEBINAR
  HACKATHON
  PLACEMENT_DRIVE
  WORKSHOP
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReportType {
  SPAM
  ABUSE
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_JOB
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  COMMUNITY
  JOB
  EVENT
  COMPANY
}

enum NotificationAudience {
  ALL
  STUDENTS
  ALUMNI
  MENTORS
  RECRUITERS
  PLACEMENT_OFFICERS
}

model Company {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  logoUrl    String?
  website    String?
  location   String
  about      String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs      Job[]
  followers CompanyFollower[]
  referrals Referral[]

  @@index([isVerified])
  @@index([slug])
}

model CompanyFollower {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, profileId])
  @@index([companyId])
}

model Job {
  id              String    @id @default(cuid())
  title           String
  description     String
  location        String
  type            JobType   @default(FULL_TIME)
  status          JobStatus @default(PENDING)
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedById      String?
  postedBy        Profile?  @relation("JobPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications JobApplication[]

  @@index([status])
  @@index([companyId])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   Profile           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, applicantId])
  @@index([jobId])
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  isRemoved   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CommunityMember[]
  posts   Post[]

  @@index([isRemoved])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER")
  isBanned    Boolean   @default(false)
  joinedAt    DateTime  @default(now())

  @@unique([communityId, profileId])
  @@index([communityId])
}

model Post {
  id            String     @id @default(cuid())
  communityId   String?
  community     Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId      String
  author        Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  isRemoved     Boolean    @default(false)
  removedReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  comments  Comment[]
  votes     PostVote[]
  bookmarks PostBookmark[]

  @@index([communityId])
  @@index([authorId])
  @@index([isRemoved])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  content   String
  isRemoved Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([postId])
  @@index([parentId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, profileId])
  @@index([postId])
  @@index([profileId])
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, profileId])
  @@index([postId])
  @@index([profileId])
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String
  type            EventType   @default(WEBINAR)
  status          EventStatus @default(PENDING)
  organizerId     String
  organizer       Profile     @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  registrations EventRegistration[]

  @@index([status])
  @@index([startsAt])
}

model Report {
  id             String           @id @default(cuid())
  type           ReportType
  status         ReportStatus     @default(PENDING)
  targetType     ReportTargetType
  targetId       String
  reason         String
  reporterId     String
  reporter       Profile          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedById   String?
  resolvedBy     Profile?         @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      Profile  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

model AdminNotification {
  id        String               @id @default(cuid())
  title     String
  message   String
  audience  NotificationAudience @default(ALL)
  sentById  String
  sentBy    Profile              @relation(fields: [sentById], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())

  @@index([audience])
  @@index([createdAt])
}

model UserSuspension {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation("SuspensionsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  reason        String
  suspendedById String
  suspendedBy   Profile   @relation("SuspensionsIssued", fields: [suspendedById], references: [id], onDelete: Cascade)
  isActive      Boolean   @default(true)
  liftedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([profileId])
  @@index([isActive])
}

// =========================================
// Social, Messaging, Referrals, Mentorship, Events & Notifications
// =========================================

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MentorshipStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_UPVOTE
  POST_COMMENT
  COMMENT_REPLY
  JOB_APPLICATION_UPDATE
  REFERRAL_UPDATE
  MENTORSHIP_UPDATE
  EVENT_REMINDER
  ADMIN_BROADCAST
}

model Connection {
  id         String           @id @default(cuid())
  senderId   String
  sender     Profile          @relation("ConnectionsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Profile          @relation("ConnectionsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@index([status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Profile  @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Profile  @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profileId      String
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, profileId])
  @@index([profileId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Profile      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Referral {
  id          String         @id @default(cuid())
  requesterId String
  requester   Profile        @relation("ReferralsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  referrerId  String
  referrer    Profile        @relation("ReferralsReceived", fields: [referrerId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobTitle    String
  jobUrl      String?
  resumeUrl   String?
  notes       String?
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([referrerId])
  @@index([requesterId])
  @@index([status])
}

model MentorshipSession {
  id          String           @id @default(cuid())
  mentorId    String
  mentor      Profile          @relation("MentorshipAsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      Profile          @relation("MentorshipAsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  topic       String
  status      MentorshipStatus @default(REQUESTED)
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())

  @@unique([eventId, profileId])
  @@index([eventId])
  @@index([profileId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   Profile          @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Profile?         @relation("TriggeredNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}
