generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                     String                    @id @default(cuid())
  clerkId                String                    @unique
  email                  String                    @unique
  username               String                    @unique
  fullName               String
  avatarUrl              String?
  bio                    String?
  headline               String?
  role                   UserRole                  @default(STUDENT)
  isOnboarded            Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  isSuspended            Boolean                   @default(false)
  isVerifiedRecruiter    Boolean                   @default(false)
  notificationsSent      AdminNotification[]
  auditLogs              AuditLog[]
  comments               Comment[]
  communityMembers       CommunityMember[]
  companiesFollowed      CompanyFollower[]
  connectionsReceived    Connection[]              @relation("ConnectionsReceived")
  connectionsSent        Connection[]              @relation("ConnectionsSent")
  conversations          ConversationParticipant[]
  education              Education[]
  eventsOrganized        Event[]                   @relation("EventOrganizer")
  eventRegistrations     EventRegistration[]
  following              Follow[]                  @relation("UserFollowing")
  followers              Follow[]                  @relation("UserFollowers")
  jobsPosted             Job[]                     @relation("JobPostedBy")
  jobApplications        JobApplication[]
  mentorshipsAsMentee    MentorshipSession[]       @relation("MentorshipAsMentee")
  mentorshipsAsMentor    MentorshipSession[]       @relation("MentorshipAsMentor")
  messagesSent           Message[]                 @relation("MessagesSent")
  notificationsTriggered Notification[]            @relation("TriggeredNotifications")
  notifications          Notification[]            @relation("UserNotifications")
  posts                  Post[]
  PostBookmarks          PostBookmark[]
  PostVotes              PostVote[]
  projects               Project[]
  referralsReceived      Referral[]                @relation("ReferralsReceived")
  referralsRequested     Referral[]                @relation("ReferralsRequested")
  reportsFiled           Report[]                  @relation("ReportsFiled")
  reportsResolved        Report[]                  @relation("ReportsResolved")
  suspensionsRecieved    UserSuspension[]          @relation("SuspensionsReceived")
  suspensionsIssued      UserSuspension[]          @relation("SuspensionsIssued")
  skills                 Skill[]                   @relation("ProfileToSkill")

  @@index([role])
  @@index([username])
  @@index([isSuspended])
}

model Skill {
  id       String    @id @default(cuid())
  name     String    @unique
  profiles Profile[] @relation("ProfileToSkill")
}

model Education {
  id           String    @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  grade        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  description String
  repoUrl     String?
  liveUrl     String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Company {
  id         String            @id @default(cuid())
  slug       String            @unique
  name       String
  logoUrl    String?
  website    String?
  location   String
  about      String
  isVerified Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  followers  CompanyFollower[]
  jobs       Job[]
  referrals  Referral[]

  @@index([isVerified])
  @@index([slug])
}

model CompanyFollower {
  id        String   @id @default(cuid())
  companyId String
  profileId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([companyId, profileId])
  @@index([companyId])
}

model Job {
  id              String           @id @default(cuid())
  title           String
  description     String
  location        String
  type            JobType          @default(FULL_TIME)
  status          JobStatus        @default(PENDING)
  companyId       String
  postedById      String?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedBy        Profile?         @relation("JobPostedBy", fields: [postedById], references: [id])
  applications    JobApplication[]

  @@index([status])
  @@index([companyId])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  applicantId String
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  applicant   Profile           @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([jobId])
}

model Community {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  isPrivate   Boolean           @default(false)
  isRemoved   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     CommunityMember[]
  posts       Post[]

  @@index([isRemoved])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  profileId   String
  role        String    @default("MEMBER")
  isBanned    Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([communityId, profileId])
  @@index([communityId])
}

model Post {
  id            String         @id @default(cuid())
  communityId   String?
  authorId      String
  content       String
  isRemoved     Boolean        @default(false)
  removedReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      Comment[]
  author        Profile        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community     Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  bookmarks     PostBookmark[]
  votes         PostVote[]

  @@index([communityId])
  @@index([authorId])
  @@index([isRemoved])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  content   String
  isRemoved Boolean   @default(false)
  createdAt DateTime  @default(now())
  parentId  String?
  author    Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([parentId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([postId])
  @@index([profileId])
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String
  profileId String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([postId])
  @@index([profileId])
}

model Event {
  id              String              @id @default(cuid())
  title           String
  description     String
  type            EventType           @default(WEBINAR)
  status          EventStatus         @default(PENDING)
  organizerId     String
  startsAt        DateTime
  endsAt          DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organizer       Profile             @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations   EventRegistration[]

  @@index([status])
  @@index([startsAt])
}

model Report {
  id             String           @id @default(cuid())
  type           ReportType
  status         ReportStatus     @default(PENDING)
  targetType     ReportTargetType
  targetId       String
  reason         String
  reporterId     String
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reporter       Profile          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     Profile?         @relation("ReportsResolved", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      Profile  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
}

model AdminNotification {
  id        String               @id @default(cuid())
  title     String
  message   String
  audience  NotificationAudience @default(ALL)
  sentById  String
  createdAt DateTime             @default(now())
  sentBy    Profile              @relation(fields: [sentById], references: [id], onDelete: Cascade)

  @@index([audience])
  @@index([createdAt])
}

model UserSuspension {
  id            String    @id @default(cuid())
  profileId     String
  reason        String
  suspendedById String
  isActive      Boolean   @default(true)
  liftedAt      DateTime?
  createdAt     DateTime  @default(now())
  profile       Profile   @relation("SuspensionsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  suspendedBy   Profile   @relation("SuspensionsIssued", fields: [suspendedById], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([isActive])
}

model Connection {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   Profile          @relation("ConnectionsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     Profile          @relation("ConnectionsSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@index([status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Profile  @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   Profile  @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  profileId      String
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([profileId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Referral {
  id          String         @id @default(cuid())
  requesterId String
  referrerId  String
  companyId   String?
  jobTitle    String
  jobUrl      String?
  resumeUrl   String?
  notes       String?
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company?       @relation(fields: [companyId], references: [id])
  referrer    Profile        @relation("ReferralsReceived", fields: [referrerId], references: [id], onDelete: Cascade)
  requester   Profile        @relation("ReferralsRequested", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([requesterId])
  @@index([status])
}

model MentorshipSession {
  id          String           @id @default(cuid())
  mentorId    String
  menteeId    String
  topic       String
  status      MentorshipStatus @default(REQUESTED)
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  mentee      Profile          @relation("MentorshipAsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor      Profile          @relation("MentorshipAsMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  profileId    String
  registeredAt DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([eventId, profileId])
  @@index([eventId])
  @@index([profileId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  actor       Profile?         @relation("TriggeredNotifications", fields: [actorId], references: [id])
  recipient   Profile          @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

enum UserRole {
  STUDENT
  ALUMNI
  MENTOR
  RECRUITER
  PLACEMENT_OFFICER
  ADMIN
}

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  SELECTED
  WITHDRAWN
}

enum EventType {
  WEBINAR
  HACKATHON
  PLACEMENT_DRIVE
  WORKSHOP
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReportType {
  SPAM
  ABUSE
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_JOB
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  COMMUNITY
  JOB
  EVENT
  COMPANY
}

enum NotificationAudience {
  ALL
  STUDENTS
  ALUMNI
  MENTORS
  RECRUITERS
  PLACEMENT_OFFICERS
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MentorshipStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_UPVOTE
  POST_COMMENT
  COMMENT_REPLY
  JOB_APPLICATION_UPDATE
  REFERRAL_UPDATE
  MENTORSHIP_UPDATE
  EVENT_REMINDER
  ADMIN_BROADCAST
}
